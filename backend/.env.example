# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (SQLite file by default; point to a Postgres URL in production)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=8h

# SMS (Twilio). Leave blank in development — the SMS service will log
# messages to the console/DB instead of sending them (SIMULATED mode).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Reminder job
SHIFT_REMINDER_HOURS_BEFORE=24
LAST_MINUTE_CANCELLATION_WINDOW_HOURS=24
